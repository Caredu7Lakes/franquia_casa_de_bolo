# Servidor NestJS
PORT=3000

# Evolution API v2.1.1
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=minha_chave_global_secreta_123
EVOLUTION_INSTANCE_NAME=casa_do_bolo_instance

# Webhooks (assinatura HMAC-SHA256 do corpo)
# Segredo compartilhado usado para validar /webhook e /ifood/webhook.
# O remetente deve enviar o HMAC-SHA256 do corpo cru no header abaixo
# (formato: "sha256=<hexdigest>"). Sem este segredo, os webhooks são recusados.
WEBHOOK_HMAC_SECRET=troque_por_um_segredo_forte
WEBHOOK_HMAC_HEADER=x-signature-256

# HTTPS (reverse proxy Caddy)
# DOMAIN: domínio com registro DNS A apontando para o IP público da VM.
# ACME_EMAIL: e-mail para avisos de renovação do Let's Encrypt.
# Requer portas 80 e 443 abertas (NSG do Azure + firewall da VM).
DOMAIN=api.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=casadobolo_user
DB_PASS=casadobolo_pass
DB_NAME=casadobolo_db

# Senha do role de runtime do backend (casadobolo_app, respeita RLS).
# Usada pela migration RLS (para criar o role) E pelo backend em produção
# (docker-compose: DB_PASS=${APP_DB_PASSWORD}). Mantenha forte e fora do git.
APP_DB_PASSWORD=troque_por_um_segredo_forte

# Cache e Fila Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Configurações do Cloudinary
CLOUDINARY_CLOUD_NAME=seu_cloud_name    
CLOUDINARY_API_KEY=seu_api_key
CLOUDINARY_API_SECRET=seu_api_secret   

# Configurações do Ifood

IFOOD_CLIENT_ID=...
IFOOD_CLIENT_SECRET=...

# Autenticação do painel (JWT)
JWT_SECRET=troque_por_um_segredo_longo_aleatorio

# Usuário OWNER inicial — criado/atualizado pelo migrate-phase2.js.
# A senha é hasheada em runtime (bcrypt); não commitar valores reais.
OWNER_EMAIL=dono@exemplo.com
OWNER_PASSWORD=troque_por_uma_senha_forte
OWNER_NAME=Casa do Bolo