# Reverse proxy com HTTPS automÃ¡tico (Let's Encrypt) + SPA do painel.
# DOMAIN e ACME_EMAIL vÃªm do ambiente (docker-compose â†’ .env).
#
# O Caddy obtÃ©m e renova o certificado sozinho, desde que:
#   - DOMAIN tenha um registro DNS A apontando para o IP pÃºblico da VM;
#   - as portas 80 e 443 estejam abertas (NSG do Azure + firewall da VM).
# A porta 80 Ã© usada no desafio ACME e redireciona para 443 automaticamente.
#
# Rotas de API vÃ£o para o backend; o resto Ã© servido como SPA (arquivos
# estÃ¡ticos do painel, com fallback para index.html). O painel usa HashRouter,
# entÃ£o as rotas de tela (#/produtos, #/clientes...) nÃ£o colidem com a API.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# API â†’ backend NestJS (JWT/HMAC validados internamente).
	@api path /auth* /users* /products* /customers* /analytics* /marketing* /webhook* /ifood/* /operational-notices*
	handle @api {
		reverse_proxy backend:3000
	}

	# Painel (SPA) â€” arquivos estÃ¡ticos com fallback para index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
